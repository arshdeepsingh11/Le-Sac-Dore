# ── Database ──────────────────────────────────────────────
# Leave empty for local development: an embedded Postgres (PGlite) is created in ./.data
# For production, use any Postgres (Neon, Supabase, RDS…). Tables are created automatically.
DATABASE_URL=

# ── Admin ─────────────────────────────────────────────────
# The admin account is created on first start. Locally (no DATABASE_URL) it defaults to
# admin@lesacdore.com / admin1234 — always set your own before going live.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── AI Concierge (optional) ───────────────────────────────
# Without a key, the concierge still answers from the built-in catalogue assistant.
ANTHROPIC_API_KEY=
CONCIERGE_MODEL=claude-sonnet-5-5
