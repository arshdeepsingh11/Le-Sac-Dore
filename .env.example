# ── Database (PostgreSQL) ─────────────────────────────────
# Empty → embedded Postgres (PGlite) in ./.data, zero setup, for quick local dev only.
# Set it → real PostgreSQL. Tables are created automatically on first start.
#   Docker (docker compose up -d):  postgres://lesacdore:lesacdore@localhost:5432/lesacdore
#   Installed Postgres:             postgres://postgres:YOUR_PASSWORD@localhost:5432/lesacdore
#   Neon / Supabase (production):   paste their connection string (SSL is used automatically)
# Optional: DATABASE_SSL=true|false to force SSL on/off, DATABASE_POOL_MAX=5
DATABASE_URL=

# ── Admin ─────────────────────────────────────────────────
# The admin account is created on first start. Locally (no DATABASE_URL) it defaults to
# admin@lesacdore.com / admin1234 — always set your own before going live.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── AI Concierge (optional) ───────────────────────────────
# Without a key, the concierge still answers from the built-in catalogue assistant.
ANTHROPIC_API_KEY=
CONCIERGE_MODEL=claude-sonnet-5-5

# ── SEO ───────────────────────────────────────────────────
# Your live domain, no trailing slash. Used for canonicals, sitemap, OG images and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://lesacdore.com
# Search Console / Bing Webmaster "HTML tag" verification codes (content value only).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
